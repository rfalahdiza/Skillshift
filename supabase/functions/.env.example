# Server-side secrets for Edge Functions. NEVER put these in the app's .env.
# Local:  copy to supabase/functions/.env (gitignored), then
#         supabase functions serve --env-file supabase/functions/.env
# Remote: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)

# Gemini (free tier). Model name is configurable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Midtrans Snap SANDBOX server key (starts with SB-Mid-server-).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
