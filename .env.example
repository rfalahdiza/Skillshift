# Copy to .env (gitignored) and fill in. Passed to Flutter at build time:
#   flutter run --dart-define-from-file=.env
# Only PUBLIC client values go here. Server keys (Gemini, Midtrans server key,
# service role) belong in Supabase function secrets, see
# supabase/functions/.env.example.

# Supabase project URL and anon (or sb_publishable_...) key.
# Local stack: printed by `supabase start`.
SUPABASE_URL=http://10.0.2.2:54321
SUPABASE_ANON_KEY=

# Password for the seeded TEST accounts (*@seed.skillshift.test).
# Debug builds only. Used by tool/gen_demo_seed.dart and the demo sign-in.
# At least 12 characters. Leave empty to disable demo sign-in.
DEMO_PASSWORD=
